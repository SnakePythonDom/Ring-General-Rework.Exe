<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RingGeneral.UI.ViewModels.Management"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RingGeneral.UI.Views.Management.OwnerDashboardView"
             x:DataType="vm:OwnerDashboardViewModel">

  <Grid RowDefinitions="Auto, *">
    <!-- Header -->
    <Border Grid.Row="0" Classes="Header" Padding="20">
      <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
        <TextBlock Text="🏛️" FontSize="32"/>
        <StackPanel>
          <TextBlock Text="DIRECTIVES DU PROPRIÉTAIRE" Classes="H1"/>
          <TextBlock Text="{Binding OwnerMood, StringFormat='Humeur Actuelle : {0}'}" 
                     Classes="H2" Foreground="#AAAAAA"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Goals List -->
    <ScrollViewer Grid.Row="1" Padding="20">
      <ItemsControl ItemsSource="{Binding ActiveGoals}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="Card" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="16"/>
                  <TextBlock Text="{Binding Status}" FontStyle="Italic"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Metric}" Foreground="#888888"/>
                    <TextBlock Text="{Binding TargetValue, StringFormat='Cible: {0}'}"/>
                    <TextBlock Text="{Binding Deadline, StringFormat='Date Limite: {0:d}'}"/>
                  </StackPanel>
                </StackPanel>
                
                <!-- Status Icon -->
                <TextBlock Grid.Column="1" 
                           Text="✅" 
                           IsVisible="{Binding Status, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Met}"
                           FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" 
                           Text="❌" 
                           IsVisible="{Binding Status, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Failed}"
                           FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" 
                           Text="⏳" 
                           IsVisible="{Binding Status, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Active}"
                           FontSize="24" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
