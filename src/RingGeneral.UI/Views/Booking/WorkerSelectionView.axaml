<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RingGeneral.UI.ViewModels.Booking"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="RingGeneral.UI.Views.Booking.WorkerSelectionView"
             x:DataType="vm:WorkerSelectionViewModel">

    <Border Background="{StaticResource BackgroundSecondaryBrush}" BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="16" BoxShadow="0 4 10 0 #40000000">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            
            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Sélectionner un participant" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <!-- Search -->
            <TextBox Grid.Row="1" Text="{Binding SearchText}" Watermark="Rechercher..." Margin="0,0,0,12"/>

            <!-- List -->
            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredWorkers}" Background="Transparent" SelectionMode="Single" Margin="0,0,0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nom}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Blessure}" IsVisible="{Binding Blessure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource ErrorBrush}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="{Binding Popularite, StringFormat='Pop: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Border Background="{Binding Fatigue, Converter={StaticResource FatigueColorConverter}}" Padding="4,2" CornerRadius="4">
                                     <TextBlock Text="{Binding Fatigue, StringFormat='{}Fat: {0}%'}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Content="+" Command="{Binding $parent[UserControl].((vm:WorkerSelectionViewModel)DataContext).SelectWorkerCommand}" CommandParameter="{Binding}" Background="{StaticResource AccentBlueBrush}" Foreground="White" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
                <ListBox.Styles>
                     <Style Selector="ListBoxItem">
                         <Setter Property="Padding" Value="8,6"/>
                         <Setter Property="CornerRadius" Value="4"/>
                     </Style>
                </ListBox.Styles>
                
                <!-- Double click to select -->
                <!-- Note: Interactivity behaviors would be better, but simple button per item works too -->
            </ListBox>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"/>
                <!-- 'Select' button logic would require binding SelectedItem from ListBox to VM -->
                <!-- Simpler to just use a button on each item OR bind SelectedItem and have a main button -->
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
