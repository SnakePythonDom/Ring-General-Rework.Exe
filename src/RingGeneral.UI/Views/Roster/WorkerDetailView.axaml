<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RingGeneral.UI.ViewModels.Roster"
             xmlns:profile="using:RingGeneral.UI.Views.Common"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RingGeneral.UI.Views.Roster.WorkerDetailView"
             x:DataType="vm:WorkerDetailViewModel">

    <Design.DataContext>
        <vm:WorkerDetailViewModel />
    </Design.DataContext>

        <Grid>
            <!-- Main Content - Always visible (below spinner) -->
            <profile:WorkerProfileView DataContext="{Binding Profile}" />

            <!-- Loading Indicator - Overlay -->
            <Grid IsVisible="{Binding IsLoading}" Background="#80000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Chargement..." FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

</UserControl>
