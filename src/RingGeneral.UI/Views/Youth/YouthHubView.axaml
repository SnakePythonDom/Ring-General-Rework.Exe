<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RingGeneral.UI.ViewModels.Youth"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RingGeneral.UI.Views.Youth.YouthHubView"
             x:DataType="vm:YouthHubViewModel">
    
    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15 10"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <TextBlock Text="CENTRE DE DÉVELOPPEMENT" FontSize="24" FontWeight="Bold" Margin="20"/>
        
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="🏛️ Structures">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding StructuresVM.Structures}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252525" CornerRadius="5" Margin="10" Padding="15" Width="300">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding Nom}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Type:" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Type}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Région:" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Region}"/>
                                        </StackPanel>
                                        
                                        <Separator Background="#444" Height="1"/>
                                        
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Budget:" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BudgetDisplay}" FontWeight="Bold"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Equipements:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EquipementsDisplay}" FontWeight="Bold" Margin="0,5,0,0"/>
                                            
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Coaching:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CoachingDisplay}" FontWeight="Bold" Margin="0,5,0,0"/>
                                        </Grid>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                                            <Button Command="{Binding UpgradeEquipmentCommand}" Content="Améliorer Infra."/>
                                            <Button Command="{Binding IncreaseBudgetCommand}" Content="+ Budget"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="👨‍🏫 Staff &amp; Coachs">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding StaffVM.Assignments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#252525" CornerRadius="5" Margin="5" Padding="10">
                          <Grid ColumnDefinitions="*, *, *">
                            <StackPanel Grid.Column="0">
                              <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="16"/>
                              <TextBlock Text="{Binding StructureName}" Foreground="#AAA" FontSize="12"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Role}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="Depuis Semaine:" Foreground="#888"/>
                                <TextBlock Text="{Binding SemaineDebut}" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="🤼 Trainees">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding TraineesVM.Trainees}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#252525" CornerRadius="5" Margin="5" Padding="10">
                          <Grid ColumnDefinitions="*, *, *, Auto">
                            <StackPanel Grid.Column="0">
                              <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="16"/>
                              <TextBlock Text="{Binding StructureName}" Foreground="#AAA" FontSize="12"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding AttributesDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Moyenne" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Average}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Statut}" Foreground="#AAA" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="🏢 Prêts Filiales">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding LoansVM.LoanedWorkers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#252525" CornerRadius="5" Margin="5" Padding="10">
                          <Grid ColumnDefinitions="*, *, *">
                            <StackPanel Grid.Column="0">
                              <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="16"/>
                              <TextBlock Text="{Binding CurrentCompany}" Foreground="#AAA" FontSize="12"/>
                            </StackPanel>
                            
                             <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="Loaned Duration" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                 <TextBlock Text="{Binding MonthsAway, StringFormat='{}{0} months'}" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                             </StackPanel>

                             <Button Grid.Column="2" Content="Rappeler" Command="{Binding RecallCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
